{
  "name": "pli-engine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "PL/I サブセット処理系（自作）。ブラウザでも Node でも動く。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "gen:snippets": "tsx scripts/gen-snippets.ts",
    "pli": "tsx scripts/pli.ts",
    "plitest": "tsx scripts/plitest.ts",
    "plilint": "tsx scripts/plilint.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
