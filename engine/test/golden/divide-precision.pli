/* 論点: DIVIDE(a,b,p,q) が指定した精度で商を作るか。

   pli-engine は既定の除算精度（q = N - ((p1-q1)+q2)）を先に通していたので、
   被除数の p が広いと q=0 の整数除算になり、あとで桁を広げても
   情報が戻らなかった（divide(a,b,5,4) が 0.0000）。

   10 進の最大精度は実機 18 / pli-engine 15 で違うが、
   DIVIDE は結果の精度を明示するので、この式は比較できる。 */
dvp: proc options(main);
  dcl a fixed dec(15,0);
  dcl b fixed dec(15,0);
  dcl c fixed dec(5,0);
  dcl d fixed dec(5,0);
  a = 2; b = 4; c = 2; d = 4;
  put skip list('divide(a,b,5,4) [', divide(a,b,5,4), ']');
  put skip list('divide(c,d,5,4) [', divide(c,d,5,4), ']');
  put skip list('divide(7,2,3,0) [', divide(7,2,3,0), ']');
  put skip list('divide(1,3,6,5) [', divide(1,3,6,5), ']');
  put skip list('divide(-7,2,4,1)[', divide(-7,2,4,1), ']');
end dvp;
