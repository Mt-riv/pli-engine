/* 論点 2a: F 書式の丸めの向き。
   切り捨てなら 1.2、四捨五入なら 1.3。
   ちょうど半分（1.25 / 1.35）で 0 から遠い側か偶数側かも見る。 */
fround: proc options(main);
  dcl x fixed dec(5,2);
  x = 1.26;
  put skip edit('1.26  f(6,1) [', x, ']')(a, f(6,1), a);
  x = 1.24;
  put skip edit('1.24  f(6,1) [', x, ']')(a, f(6,1), a);
  x = 1.25;
  put skip edit('1.25  f(6,1) [', x, ']')(a, f(6,1), a);
  x = 1.35;
  put skip edit('1.35  f(6,1) [', x, ']')(a, f(6,1), a);
  x = -1.26;
  put skip edit('-1.26 f(6,1) [', x, ']')(a, f(6,1), a);
  x = -1.25;
  put skip edit('-1.25 f(6,1) [', x, ']')(a, f(6,1), a);
  x = 1.99;
  put skip edit('1.99  f(4,0) [', x, ']')(a, f(4,0), a);
  x = 0.05;
  put skip edit('0.05  f(5,1) [', x, ']')(a, f(5,1), a);
end fround;
