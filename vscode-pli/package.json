{
  "name": "pli-lang",
  "displayName": "PL/I",
  "description": "%extension.description%",
  "version": "0.5.0",
  "private": true,
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mt-riv/pli-engine.git",
    "directory": "vscode-pli"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:pli",
    "onLanguage:pl1"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pli",
        "aliases": [
          "PL/I",
          "pli"
        ],
        "extensions": [
          ".pli",
          ".pl1",
          ".plinc",
          ".inc",
          ".cpy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pli",
        "scopeName": "source.pli",
        "path": "./syntaxes/pli.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pli.run",
        "title": "%command.run.title%",
        "icon": "$(play)"
      },
      {
        "command": "pli.runWithArgs",
        "title": "%command.runWithArgs.title%"
      },
      {
        "command": "pli.runTests",
        "title": "%command.runTests.title%",
        "icon": "$(beaker)"
      },
      {
        "command": "pli.runScreen",
        "title": "%command.runScreen.title%",
        "icon": "$(device-desktop)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pli.run",
          "when": "resourceLangId == pli || resourceLangId == pl1",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "pli.run",
          "when": "resourceLangId == pli || resourceLangId == pl1"
        },
        {
          "command": "pli.runWithArgs",
          "when": "resourceLangId == pli || resourceLangId == pl1"
        },
        {
          "command": "pli.runTests",
          "when": "resourceLangId == pli || resourceLangId == pl1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pli.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "(resourceLangId == pli || resourceLangId == pl1) && editorTextFocus"
      },
      {
        "command": "pli.runTests",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "(resourceLangId == pli || resourceLangId == pl1) && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "PL/I",
      "properties": {
        "pli.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.diagnostics.enabled%"
        },
        "pli.dli.psb": {
          "type": "string",
          "default": "",
          "pattern": "^([A-Za-z0-9$#@]{1,8})?$",
          "patternErrorMessage": "%config.dli.psb.pattern%",
          "scope": "machine-overridable",
          "description": "%config.dli.psb%"
        },
        "pli.run.maxSteps": {
          "type": "number",
          "default": 5000000,
          "minimum": 1,
          "description": "%config.run.maxSteps%"
        },
        "pli.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.lint.enabled%"
        },
        "pli.lint.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.lint.rules%",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "info",
              "warning",
              "error"
            ]
          }
        },
        "pli.language": {
          "type": "string",
          "enum": [
            "auto",
            "ja",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.ja%",
            "%config.language.en%"
          ],
          "description": "%config.language%"
        },
        "pli.run.maxOutputBytes": {
          "type": "number",
          "default": 1000000,
          "minimum": 1,
          "description": "%config.run.maxOutputBytes%"
        }
      }
    },
    "snippets": [
      {
        "language": "pli",
        "path": "./snippets/pli.json"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
