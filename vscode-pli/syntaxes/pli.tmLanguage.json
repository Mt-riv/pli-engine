{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PL/I",
  "scopeName": "source.pli",
  "_comment": "PL/I には予約語が無く、IF や THEN をそのまま変数名に使える（IF IF = THEN THEN THEN = ELSE; は合法）。したがってキーワードの着色は本質的に近似でしかない。ここでは実用上読みやすくなることを優先し、語形だけで着色する。厳密な判定が必要な場合は拡張が提供する診断（エンジンによる構文解析）を使う。",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#label"
    },
    {
      "include": "#condition"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#dli"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#unimplemented"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.pli",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "preprocessor": {
      "name": "meta.preprocessor.pli",
      "begin": "(?i)(%)\\s*(replace|include|page|skip|print|noprint|process|declare|dcl|if|then|else|do|end|goto)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.pli"
        },
        "2": {
          "name": "keyword.control.directive.pli"
        }
      },
      "end": ";",
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#number"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.single.pli",
          "begin": "'",
          "end": "'(?!')",
          "patterns": [
            {
              "name": "constant.character.escape.pli",
              "match": "''"
            }
          ]
        },
        {
          "name": "string.quoted.double.pli",
          "begin": "\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.pli",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.pli",
          "match": "(?i)\\b\\d+(\\.\\d+)?([eE][-+]?\\d+)?\\b"
        }
      ]
    },
    "label": {
      "name": "entity.name.function.pli",
      "match": "(?i)^\\s*([A-Za-z_$#@][A-Za-z0-9_$#@]*)\\s*:",
      "captures": {
        "1": {
          "name": "entity.name.function.pli"
        }
      }
    },
    "condition": {
      "name": "support.type.condition.pli",
      "match": "(?i)(?<=\\bon\\s)\\s*(subscriptrange|undefinedfile|fixedoverflow|anycondition|stringrange|stringsize|conversion|zerodivide|condition|underflow|attention|transmit|overflow|storage|endpage|endfile|record|finish|error|size|area|attn|name|key)\\b"
    },
    "keyword": {
      "name": "keyword.other.pli",
      "match": "(?i)\\b(nonconnected|environment|sequential|controlled|automatic|unaligned|connected|character|reentrant|procedure|recursive|otherwise|position|allocate|internal|unsigned|priority|external|picture|default|generic|package|options|iterate|defined|pointer|keyfrom|aligned|rewrite|byvalue|varying|returns|decimal|initial|builtin|display|declare|complex|string|record|offset|revert|direct|return|signed|binary|static|signal|select|stream|byaddr|locate|delete|update|output|repeat|format|other|refer|based|keyed|print|float|title|write|close|reply|union|event|while|entry|value|until|label|begin|input|fixed|leave|real|open|free|line|edit|stop|area|page|read|task|else|when|call|init|proc|auto|into|exit|data|goto|cplx|from|null|list|imag|then|like|skip|copy|file|char|bin|get|ptr|pos|key|put|end|bit|set|ext|int|pic|dcl|var|dec|env|def|ctl|if|do|on|go|to|by)\\b"
    },
    "dli": {
      "name": "support.function.dli.pli",
      "match": "(?i)\\b(plitdli|cbltdli|asmtdli|aibtdli)\\b"
    },
    "builtin": {
      "_comment": "この処理系が実装している組込関数。engine/src/interp.ts の BUILTIN_NAMES と一致させる（vscode-pli/test/grammar.test.ts が固定）。",
      "name": "support.function.builtin.pli",
      "match": "(?i)\\b(translate|divide|hbound|lbound|length|repeat|substr|verify|floor|index|round|trunc|addr|ceil|null|sign|abs|dim|max|min|mod)\\b(?=\\s*\\()"
    },
    "operator": {
      "name": "keyword.operator.pli",
      "match": "(\\*\\*|\\|\\||<=|>=|\\^=|¬=|\\^<|¬<|\\^>|¬>|[-+*/=<>|&^¬])"
    },
    "unimplemented": {
      "_comment": "PL/I の組込関数のうち、この処理系が実装していないもの。別スコープにしてテーマで色を分けられるようにする（呼ぶと実行時に「未知の関数です」で止まる）。",
      "name": "support.function.unimplemented.pli",
      "match": "(?i)\\b(currentstorage|binaryvalue|allocation|daystodate|character|datafield|dimension|lowercase|maxlength|precision|uppercase|datetime|heximage|multiply|oncondid|onsource|unsigned|charval|collate|complex|decimal|omitted|oncount|pointer|reverse|searchr|storage|binary|lineno|offset|onchar|oncode|onfile|pageno|random|search|signed|string|unspec|acosd|asind|atand|atanh|conjg|count|decat|empty|fixed|float|log10|onkey|onloc|valid|acos|asin|atan|bool|byte|char|copy|cosd|cosh|date|days|erfc|high|iand|ieor|imag|inot|log2|poly|prec|prod|rank|real|sind|sinh|sqrt|tand|tanh|time|trim|add|all|any|bin|bit|cos|dec|erf|exp|hex|ior|log|low|sin|sum|tan)\\b(?=\\s*\\()"
    }
  }
}
